{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonfind/series-use-case@1.0.0",
  "title": "MoonSuite Series Use Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "use_case_id",
    "title",
    "summary",
    "primary_user",
    "primary_action",
    "completion_statement",
    "phases",
    "graph"
  ],
  "properties": {
    "contract_id": { "const": "moonsuite.series-use-case.v1" },
    "use_case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "primary_user": { "type": "string", "minLength": 1 },
    "primary_action": { "type": "string", "minLength": 1 },
    "completion_statement": { "type": "string", "minLength": 1 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase_id", "title", "outcome", "product_ids", "stage_ids"],
        "properties": {
          "phase_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 },
          "product_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" }
          },
          "stage_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "contract_id",
        "graph_id",
        "book_id",
        "declaration_revision",
        "source_digest",
        "stages"
      ],
      "properties": {
        "contract_id": { "const": "moonfind.desired-capability-graph.v2" },
        "graph_id": { "type": "string", "minLength": 1 },
        "book_id": { "type": "string", "minLength": 1 },
        "declaration_revision": { "type": "string", "minLength": 1 },
        "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "stages": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    }
  }
}
