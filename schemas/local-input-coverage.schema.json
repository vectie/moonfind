{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonfind.local-input-coverage.v1",
  "type": "object",
  "required": [
    "contract_version",
    "ledger_id",
    "source_label",
    "expected_input_count",
    "inputs",
    "known_missing_inputs",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_version": {"const": "moonfind.local-input-coverage.v1"},
    "ledger_id": {"type": "string", "minLength": 1},
    "source_label": {"type": "string", "minLength": 1},
    "expected_input_count": {"type": "integer", "minimum": 1},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "input_id",
          "relative_path",
          "source_digest",
          "byte_length",
          "media_type",
          "sequence_number",
          "status",
          "evidence_anchors",
          "provenance_ref"
        ],
        "properties": {
          "input_id": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "source_digest": {"type": "string", "pattern": "^sha256:"},
          "byte_length": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1},
          "sequence_number": {"type": "integer", "minimum": 1},
          "status": {
            "enum": [
              "Ingested",
              "Extracted",
              "Used",
              "Duplicate",
              "Unsupported",
              "Failed"
            ]
          },
          "extraction_artifact": {"type": ["string", "null"]},
          "evidence_anchors": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "provenance_ref": {"type": "string", "minLength": 1},
          "duplicate_of": {"type": ["string", "null"]},
          "failure_reason": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "known_missing_inputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "created_at": {"type": "integer", "minimum": 0},
    "updated_at": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
