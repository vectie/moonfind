{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonfind.research-job.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "job_id", "objective", "audience", "source_scope", "requested_outputs", "created_at"],
  "properties": {
    "contract_id": {"const": "moonfind.research-job.v1"},
    "job_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "source_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requested_outputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["output_id", "title", "kind", "format", "acceptance_criteria"],
        "properties": {
          "output_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "created_at": {"type": "integer", "minimum": 0}
  }
}
