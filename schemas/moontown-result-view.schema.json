{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonfind/moontown-result-view@1.0.0",
  "title": "Read-only correlated MoonTown synthesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "run_id", "state", "detail"],
  "properties": {
    "contract_id": { "const": "moonfind.moontown-result-view.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "state": { "enum": ["available", "unavailable"] },
    "detail": { "type": "string", "minLength": 1 },
    "source_ref": { "type": ["string", "null"] },
    "source_digest": { "type": ["string", "null"] },
    "output": {
      "anyOf": [
        { "$ref": "#/$defs/output" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "available" } } },
      "then": {
        "required": ["source_ref", "source_digest", "output"],
        "properties": {
          "source_ref": { "type": "string", "minLength": 1 },
          "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "output": { "$ref": "#/$defs/output" }
        }
      },
      "else": {
        "properties": {
          "source_ref": { "type": "null" },
          "source_digest": { "type": "null" },
          "output": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "scenario_id", "participant_book_ids", "ideas"],
      "properties": {
        "contract_id": { "const": "civic.communication.output.v1" },
        "scenario_id": { "type": "string", "minLength": 1 },
        "participant_book_ids": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "ideas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "summary", "participating_books", "research_questions", "why_it_matters", "next_experiment"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "participating_books": { "type": "array", "minItems": 2, "items": { "type": "string" } },
              "research_questions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "why_it_matters": { "type": "string", "minLength": 1 },
              "next_experiment": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
