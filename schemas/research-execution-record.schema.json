{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonfind/research-execution-record@1.0.0",
  "title": "MoonFind Research Execution Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "revision",
    "run_id",
    "operation_ref",
    "request_id",
    "attempt_id",
    "idempotency_key",
    "state",
    "invocation",
    "error_kind",
    "requires_review",
    "next_action",
    "updated_at"
  ],
  "properties": {
    "contract_id": { "const": "moonfind.research-execution-record.v1" },
    "revision": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "operation_ref": {
      "const": "moonfind/research.prepare-analysis@0.1.0"
    },
    "request_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "state": {
      "enum": [
        "prepared",
        "submitting",
        "pending",
        "unknown",
        "failed",
        "command-ready",
        "runtime-submitting",
        "runtime-pending",
        "runtime-unknown",
        "runtime-failed",
        "needs-review"
      ]
    },
    "invocation": {
      "type": "object",
      "required": ["contract_id", "adapter_id", "attempt", "request"],
      "properties": {
        "contract_id": { "const": "moonclaw.capability-invocation.v1" },
        "adapter_id": { "type": "string", "minLength": 1 },
        "attempt": { "const": 1 },
        "request": {
          "type": "object",
          "required": [
            "request_id",
            "attempt_id",
            "idempotency_key",
            "operation",
            "input_digest"
          ],
          "properties": {
            "request_id": { "type": "string", "minLength": 1 },
            "attempt_id": { "type": "string", "minLength": 1 },
            "idempotency_key": { "type": "string", "minLength": 1 },
            "operation": {
              "const": "moonfind/research.prepare-analysis@0.1.0"
            },
            "input_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "receipt_ref": { "type": ["string", "null"] },
    "receipt": { "type": ["object", "null"] },
    "result_ref": { "type": ["string", "null"] },
    "moonclaw_session_key": { "type": ["string", "null"] },
    "moonclaw_run_id": { "type": ["string", "null"] },
    "moonclaw_run": { "type": ["object", "null"] },
    "error_kind": { "type": "string" },
    "requires_review": { "type": "boolean" },
    "next_action": { "type": "string", "minLength": 1 },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
