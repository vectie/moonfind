{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonfind.delivery-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "job_id", "outputs"],
  "properties": {
    "contract_id": {"const": "moonfind.delivery-evidence.v1"},
    "job_id": {"type": "string", "minLength": 1},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output_id", "evidence_refs", "checks"],
        "properties": {
          "output_id": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion", "status", "evidence_ref"],
              "properties": {
                "criterion": {"type": "string", "minLength": 1},
                "status": {"const": "passed"},
                "evidence_ref": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
