{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonfind.delivery-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "job_id", "outputs", "open_gaps", "review_status", "delivered_at"],
  "properties": {
    "contract_id": {"const": "moonfind.delivery-manifest.v1"},
    "job_id": {"type": "string", "minLength": 1},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["output_id", "artifact_ref", "media_type", "artifact_digest", "byte_length", "evidence_refs", "checks"],
        "properties": {
          "output_id": {"type": "string", "minLength": 1},
          "artifact_ref": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "byte_length": {"type": "integer", "minimum": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "checks": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["criterion", "status", "evidence_ref"],
              "properties": {
                "criterion": {"type": "string", "minLength": 1},
                "status": {"const": "passed"},
                "evidence_ref": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "open_gaps": {"type": "array", "items": {"type": "string"}},
    "review_status": {"enum": ["pending-review", "accepted"]},
    "delivered_at": {"type": "integer", "minimum": 0}
  }
}
