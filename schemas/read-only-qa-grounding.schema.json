{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonfind.read-only-qa-grounding.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "packet_id",
    "book_id",
    "job_id",
    "run_id",
    "step_id",
    "source_review_id",
    "review_state",
    "accepted",
    "durable_memory_promotion_state",
    "decision_recorded",
    "decision_authority",
    "allowed_human_outcomes",
    "runtime",
    "mode",
    "retrieval_order",
    "artifacts",
    "citation_coverage",
    "answer_labels",
    "confidence_levels",
    "privacy",
    "known_missing_pages",
    "integrity_policy",
    "activation_gate",
    "approval_gate",
    "side_effects_applied"
  ],
  "properties": {
    "contract_version": {"const": "moonfind.read-only-qa-grounding.v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "book_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "source_review_id": {"type": "string", "minLength": 1},
    "review_state": {"enum": ["pending_review", "accepted", "rejected"]},
    "accepted": {"type": "boolean"},
    "durable_memory_promotion_state": {"enum": ["not_promoted", "promoted"]},
    "decision_recorded": {"type": "boolean"},
    "decision_authority": {"type": "string", "minLength": 1},
    "allowed_human_outcomes": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["approve_subset", "request_changes", "reject"]}
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "session_id",
        "state",
        "launched",
        "hosted",
        "later_cowork_session_owns_activation"
      ],
      "properties": {
        "owner": {"const": "MoonClaw"},
        "session_id": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1},
        "launched": {"type": "boolean"},
        "hosted": {"type": "boolean"},
        "later_cowork_session_owns_activation": {"const": true}
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "web_update_policy",
        "persistence_policy",
        "required_review"
      ],
      "properties": {
        "read_only": {"const": true},
        "web_update_policy": {"const": "label-separately"},
        "persistence_policy": {"const": "moonbook-review-only"},
        "required_review": {"const": "named-human"}
      }
    },
    "retrieval_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/bookRelativePath"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"$ref": "#/$defs/bookRelativePath"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "citation_coverage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["present"],
        "anyOf": [
          {"required": ["expected"]},
          {"required": ["expected_citations"]}
        ],
        "properties": {
          "domain": {"type": "string"},
          "expected": {"type": "integer", "minimum": 0},
          "expected_citations": {"type": "integer", "minimum": 0},
          "present": {"type": "integer", "minimum": 0},
          "reconstructed": {"type": "boolean"}
        }
      }
    },
    "answer_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "reviewed-book",
          "pending-review-book",
          "later-web-update",
          "analysis"
        ]
      }
    },
    "confidence_levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["high", "moderate", "low", "not estimable"]}
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_corpus_may_be_copied",
        "private_material_may_be_uploaded",
        "personal_handles_may_be_reproduced_by_default",
        "extended_private_text_may_be_quoted",
        "use_book_relative_paths_and_anchors"
      ],
      "properties": {
        "private_corpus_may_be_copied": {"const": false},
        "private_material_may_be_uploaded": {"const": false},
        "personal_handles_may_be_reproduced_by_default": {"const": false},
        "extended_private_text_may_be_quoted": {"const": false},
        "use_book_relative_paths_and_anchors": {"const": true}
      }
    },
    "known_missing_pages": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "integrity_policy": {
      "const": "fail-closed-on-any-artifact-digest-mismatch"
    },
    "activation_gate": {"type": "string", "minLength": 1},
    "approval_gate": {"type": "string", "minLength": 1},
    "side_effects_applied": {"const": false}
  },
  "$defs": {
    "bookRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
