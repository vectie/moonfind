///|
// Emit the real host serialization into the UI's test package. This is a
// synthetic transport fixture only: no listeners, providers or credentials.
async test "model chooser emits actual host projections for UI contract tests" {
  let config = model_route_config()
  let configured = native_model_route_with(config, fetch=(path, body) => {
    assert_eq(path, "/v1/cowork/model-route")
    assert_eq(body, { "cwd": "/trusted/book" })
    cowork_route_fixture()
  })
  let no_default = native_model_route_with(config, fetch=(_, _) => {
    let value = cowork_route_fixture()
    if value is Object(fields) {
      fields["default_ready"] = false.to_json()
      fields["default_model"] = "".to_json()
      fields["blocker"] = "MoonGate default model is not configured for this Cowork workspace.".to_json()
    }
    value
  })
  let offline = native_model_route_with(config, fetch=(_, _) => fail("offline"))
  let missing_gateway = native_model_route_with(
    { ..config, moonclaw_gateway_base: None, },
    fetch=(_, _) => fail("must not fetch without gateway"),
  )
  let stale = native_model_route_with({ ..config, run_id: "other-run", }, fetch=(
    _,
    _,
  ) => cowork_route_fixture())
  let rows = [configured, no_default, offline, missing_gateway, stale].map(route => {
    ToJson::to_json(route)
  })
  assert_true(configured.default_ready && configured.catalog_ready)
  assert_true(no_default.catalog_ready && !no_default.default_ready)
  assert_false(offline.catalog_ready || missing_gateway.catalog_ready)
  let serialized = Json::array(rows).stringify()
  assert_false(serialized.contains("fixture-server-token"))
  assert_false(serialized.contains("configured-cowork.invalid"))
  @fs.write_file(
    "ui/rabbita-moonfind/main/model_picker_contract_fixture_wbtest.mbt",
    "// Generated by host/model_picker_contract_wbtest.mbt from the production serializer.\n///|\nfn chooser_host_serialized() -> String {\n    #|" +
    serialized +
    "\n}\n\n///|\nfn chooser_host_fixtures() -> Array[NativeModelRoute] raise {\n  @json.from_json(@json.parse(chooser_host_serialized()))\n}\n",
    create_mode=CreateOrTruncate,
  )
}
